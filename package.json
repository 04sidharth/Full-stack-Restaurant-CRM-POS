{
  "name": "restaurant-crm",
  "private": true,
  "version": "0.1.0",
  "description": "Multi-tenant restaurant CRM / POS (Petpooja-style)",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm-run-all -p dev:api dev:web",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "build": "npm-run-all build:api build:web",
    "build:api": "npm --workspace apps/api run build",
    "build:web": "npm --workspace apps/web run build",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "npm --workspace apps/api run prisma:migrate",
    "db:seed": "npm --workspace apps/api run prisma:seed",
    "db:studio": "npm --workspace apps/api run prisma:studio",
    "lint": "npm-run-all -p lint:api lint:web",
    "lint:api": "npm --workspace apps/api run lint",
    "lint:web": "npm --workspace apps/web run lint",
    "test": "npm-run-all test:api test:web",
    "test:api": "npm --workspace apps/api run test",
    "test:web": "npm --workspace apps/web run test"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "react-is": "^19.2.6"
  }
}
