// Restaurant CRM — Prisma schema
// Multi-tenant: every business entity carries a restaurantId.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Tenant + Auth
// ============================================================================

model Restaurant {
  id              String   @id @default(cuid())
  name            String
  legalName       String?
  gstNumber       String?
  fssaiNumber     String?
  email           String?
  phone           String?
  addressLine1    String?
  addressLine2    String?
  city            String?
  state           String?
  pincode         String?
  currency        String   @default("INR")
  timezone        String   @default("Asia/Kolkata")
  taxInclusive    Boolean  @default(false)
  serviceCharge   Decimal  @default(0) @db.Decimal(5, 2)
  invoicePrefix   String   @default("INV")
  nextInvoiceSeq  Int      @default(1)
  nextOrderSeq    Int      @default(1)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users           User[]
  categories      Category[]
  menuItems       MenuItem[]
  modifierGroups  ModifierGroup[]
  sections        Section[]
  tables          Table[]
  orders          Order[]
  invoices        Invoice[]
  payments        Payment[]
  customers       Customer[]
  loyaltyTxns     LoyaltyTransaction[]
  feedbacks       Feedback[]
  stockItems      StockItem[]
  stockMovements  StockMovement[]
  auditLogs       AuditLog[]
  leads           Lead[]
  communications  Communication[]
  tasks           Task[]
  campaigns       Campaign[]

  @@index([active])
}

enum UserRole {
  OWNER
  MANAGER
  CASHIER
  WAITER
  KITCHEN
}

model User {
  id            String    @id @default(cuid())
  restaurantId  String
  email         String
  passwordHash  String
  name          String
  phone         String?
  role          UserRole  @default(WAITER)
  active        Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  ordersCreated Order[]    @relation("OrderCreatedBy")
  payments      Payment[]  @relation("PaymentReceivedBy")
  auditLogs     AuditLog[]
  leadsAssigned      Lead[]          @relation("LeadAssignee")
  leadsCreated       Lead[]          @relation("LeadCreator")
  commsCreated       Communication[] @relation("CommCreator")
  tasksAssigned      Task[]          @relation("TaskAssignee")
  tasksCreated       Task[]          @relation("TaskCreator")
  campaignsCreated   Campaign[]      @relation("CampaignCreator")

  @@unique([restaurantId, email])
  @@index([restaurantId])
}

// ============================================================================
// Menu
// ============================================================================

enum FoodType {
  VEG
  NONVEG
  EGG
  VEGAN
}

model Category {
  id            String    @id @default(cuid())
  restaurantId  String
  name          String
  description   String?
  imageUrl      String?
  sortOrder     Int       @default(0)
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items         MenuItem[]

  @@unique([restaurantId, name])
  @@index([restaurantId, sortOrder])
}

model MenuItem {
  id              String   @id @default(cuid())
  restaurantId    String
  categoryId      String
  name            String
  description     String?
  imageUrl        String?
  basePrice       Decimal  @db.Decimal(10, 2)
  taxRate         Decimal  @default(5) @db.Decimal(5, 2)
  foodType        FoodType @default(VEG)
  available       Boolean  @default(true)
  isRecommended   Boolean  @default(false)
  sortOrder       Int      @default(0)
  preparationMins Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category     Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants     Variant[]
  modifierLinks MenuItemModifierGroup[]
  orderItems   OrderItem[]
  recipes      Recipe[]

  @@index([restaurantId, categoryId])
  @@index([restaurantId, available])
}

model Variant {
  id          String   @id @default(cuid())
  menuItemId  String
  name        String          // "Half", "Full", "Regular", "Large"
  priceDelta  Decimal  @default(0) @db.Decimal(10, 2)
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)

  menuItem    MenuItem    @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]

  @@index([menuItemId])
}

model ModifierGroup {
  id            String   @id @default(cuid())
  restaurantId  String
  name          String          // "Add-ons", "Spice level"
  minSelect     Int      @default(0)
  maxSelect     Int      @default(1)
  required      Boolean  @default(false)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  options    Modifier[]
  itemLinks  MenuItemModifierGroup[]

  @@index([restaurantId])
}

model Modifier {
  id        String   @id @default(cuid())
  groupId   String
  name      String          // "Extra cheese"
  priceDelta Decimal @default(0) @db.Decimal(10, 2)
  active    Boolean  @default(true)

  group ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

model MenuItemModifierGroup {
  menuItemId String
  groupId    String

  menuItem MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  group    ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([menuItemId, groupId])
}

// ============================================================================
// Tables / Floor
// ============================================================================

enum TableStatus {
  FREE
  OCCUPIED
  BILLED
  RESERVED
  CLEANING
}

model Section {
  id            String   @id @default(cuid())
  restaurantId  String
  name          String          // Indoor, Outdoor, Rooftop
  sortOrder     Int      @default(0)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tables     Table[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
}

model Table {
  id           String      @id @default(cuid())
  restaurantId String
  sectionId    String
  name         String           // "T1", "T2"
  capacity     Int         @default(4)
  status       TableStatus @default(FREE)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  section    Section    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@unique([restaurantId, name])
  @@index([restaurantId, status])
}

// ============================================================================
// Orders + Items + Payments + Invoice
// ============================================================================

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  PREPARING
  READY
  SERVED
  COMPLETED
  CANCELLED
}

enum OrderItemStatus {
  PENDING
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  WALLET
  CREDIT
  OTHER
}

model Order {
  id              String      @id @default(cuid())
  restaurantId    String
  orderNumber     String           // e.g., 000123
  type            OrderType
  status          OrderStatus @default(DRAFT)
  tableId         String?
  customerId      String?
  createdById     String
  guestCount      Int         @default(1)
  notes           String?

  // money (snapshot at billing)
  subTotal        Decimal     @default(0) @db.Decimal(10, 2)
  discountAmount  Decimal     @default(0) @db.Decimal(10, 2)
  discountReason  String?
  serviceCharge   Decimal     @default(0) @db.Decimal(10, 2)
  taxAmount       Decimal     @default(0) @db.Decimal(10, 2)
  roundOff        Decimal     @default(0) @db.Decimal(10, 2)
  total           Decimal     @default(0) @db.Decimal(10, 2)

  kotPrintedAt    DateTime?
  billedAt        DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table      Table?     @relation(fields: [tableId], references: [id])
  customer   Customer?  @relation(fields: [customerId], references: [id])
  createdBy  User       @relation("OrderCreatedBy", fields: [createdById], references: [id])

  items      OrderItem[]
  payments   Payment[]
  invoice    Invoice?
  loyaltyTxns LoyaltyTransaction[]
  feedbacks  Feedback[]
  stockMovements StockMovement[]

  @@unique([restaurantId, orderNumber])
  @@index([restaurantId, status])
  @@index([restaurantId, createdAt])
  @@index([restaurantId, tableId])
  @@index([restaurantId, customerId])
}

model OrderItem {
  id           String          @id @default(cuid())
  orderId      String
  menuItemId   String
  variantId    String?
  // snapshot fields — keep historical pricing even if menu changes
  nameSnapshot String
  unitPrice    Decimal         @db.Decimal(10, 2)
  taxRate      Decimal         @db.Decimal(5, 2)
  quantity     Int             @default(1)
  modifiers    Json?           // [{groupId,name,priceDelta}]
  notes        String?
  status       OrderItemStatus @default(PENDING)
  kotPrintedAt DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])
  variant  Variant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([status])
}

model Payment {
  id           String        @id @default(cuid())
  restaurantId String
  orderId      String
  method       PaymentMethod
  amount       Decimal       @db.Decimal(10, 2)
  reference    String?            // txn id, last 4 of card, etc.
  receivedById String
  receivedAt   DateTime      @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  receivedBy User       @relation("PaymentReceivedBy", fields: [receivedById], references: [id])

  @@index([restaurantId, receivedAt])
  @@index([orderId])
}

model Invoice {
  id            String   @id @default(cuid())
  restaurantId  String
  orderId       String   @unique
  invoiceNumber String           // "INV-2026-000123"
  subTotal      Decimal  @db.Decimal(10, 2)
  discountAmount Decimal @default(0) @db.Decimal(10, 2)
  cgst          Decimal  @default(0) @db.Decimal(10, 2)
  sgst          Decimal  @default(0) @db.Decimal(10, 2)
  igst          Decimal  @default(0) @db.Decimal(10, 2)
  serviceCharge Decimal  @default(0) @db.Decimal(10, 2)
  roundOff      Decimal  @default(0) @db.Decimal(10, 2)
  total         Decimal  @db.Decimal(10, 2)
  issuedAt      DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, invoiceNumber])
  @@index([restaurantId, issuedAt])
}

// ============================================================================
// Customers / CRM
// ============================================================================

model Customer {
  id            String   @id @default(cuid())
  restaurantId  String
  phone         String
  name          String?
  email         String?
  dob           DateTime?
  anniversary   DateTime?
  gstNumber     String?
  addressLine1  String?
  city          String?
  pincode       String?
  notes         String?
  loyaltyPoints Int      @default(0)
  totalOrders   Int      @default(0)
  totalSpend    Decimal  @default(0) @db.Decimal(12, 2)
  lastVisitAt   DateTime?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tags           String[]        @default([])

  restaurant     Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders         Order[]
  loyaltyTxns    LoyaltyTransaction[]
  feedbacks      Feedback[]
  communications Communication[]
  tasks          Task[]
  campaignLogs   CampaignLog[]

  @@unique([restaurantId, phone])
  @@index([restaurantId, name])
  @@index([restaurantId, active, lastVisitAt])
  @@index([restaurantId, totalOrders])
  @@index([restaurantId, totalSpend])
}

enum LoyaltyTxnType {
  EARN
  REDEEM
  ADJUST
  EXPIRE
}

model LoyaltyTransaction {
  id           String         @id @default(cuid())
  restaurantId String
  customerId   String
  orderId      String?
  type         LoyaltyTxnType
  points       Int                  // signed: positive earn/adjust+, negative redeem/expire
  note         String?
  createdAt    DateTime       @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order      Order?     @relation(fields: [orderId], references: [id])

  @@index([restaurantId, customerId])
}

model Feedback {
  id           String   @id @default(cuid())
  restaurantId String
  customerId   String?
  orderId      String?
  rating       Int                // 1..5
  foodRating   Int?
  serviceRating Int?
  comment      String?
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer   Customer?  @relation(fields: [customerId], references: [id])
  order      Order?     @relation(fields: [orderId], references: [id])

  @@index([restaurantId, createdAt])
}

// ============================================================================
// Inventory / Stock / Recipes
// ============================================================================

enum StockUnit {
  KG
  GRAM
  LITRE
  ML
  PIECE
  DOZEN
  PACKET
}

model StockItem {
  id           String    @id @default(cuid())
  restaurantId String
  name         String
  sku          String?
  unit         StockUnit
  currentQty   Decimal   @default(0) @db.Decimal(12, 3)
  minQty       Decimal   @default(0) @db.Decimal(12, 3)
  costPerUnit  Decimal   @default(0) @db.Decimal(10, 2)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  restaurant Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  recipes    Recipe[]
  movements  StockMovement[]

  @@unique([restaurantId, name])
  @@index([restaurantId, active])
}

model Recipe {
  id          String  @id @default(cuid())
  menuItemId  String
  stockItemId String
  quantity    Decimal @db.Decimal(12, 3)    // per 1 order item, in stock's unit

  menuItem  MenuItem  @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  stockItem StockItem @relation(fields: [stockItemId], references: [id], onDelete: Restrict)

  @@unique([menuItemId, stockItemId])
  @@index([menuItemId])
}

enum StockMovementType {
  PURCHASE
  CONSUMPTION
  ADJUSTMENT
  WASTE
  OPENING
}

model StockMovement {
  id           String            @id @default(cuid())
  restaurantId String
  stockItemId  String
  type         StockMovementType
  quantity     Decimal           @db.Decimal(12, 3)   // signed
  unitCost     Decimal?          @db.Decimal(10, 2)
  orderId      String?
  note         String?
  createdAt    DateTime          @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  stockItem  StockItem  @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  order      Order?     @relation(fields: [orderId], references: [id])

  @@index([restaurantId, createdAt])
  @@index([stockItemId])
}

// ============================================================================
// CRM — Leads · Communications · Tasks
// ============================================================================

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

enum LeadSource {
  WALK_IN
  WEBSITE
  REFERRAL
  SOCIAL_MEDIA
  PHONE
  EMAIL
  OTHER
}

model Lead {
  id            String      @id @default(cuid())
  restaurantId  String
  name          String
  phone         String?
  email         String?
  company       String?
  status        LeadStatus  @default(NEW)
  source        LeadSource  @default(OTHER)
  value         Decimal     @default(0) @db.Decimal(12, 2)
  notes         String?
  assignedToId  String?
  createdById   String
  expectedClose DateTime?
  wonAt         DateTime?
  lostAt        DateTime?
  lostReason    String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  restaurant     Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  assignedTo     User?           @relation("LeadAssignee", fields: [assignedToId], references: [id])
  createdBy      User            @relation("LeadCreator", fields: [createdById], references: [id])
  communications Communication[]
  tasks          Task[]

  @@index([restaurantId, status])
  @@index([restaurantId, createdAt])
}

enum CommType {
  CALL
  EMAIL
  WHATSAPP
  NOTE
  MEETING
  SMS
}

enum CommDirection {
  INBOUND
  OUTBOUND
}

model Communication {
  id           String        @id @default(cuid())
  restaurantId String
  customerId   String?
  leadId       String?
  type         CommType
  direction    CommDirection @default(OUTBOUND)
  subject      String?
  body         String
  durationMins Int?
  createdById  String
  createdAt    DateTime      @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer   Customer?  @relation(fields: [customerId], references: [id])
  lead       Lead?      @relation(fields: [leadId], references: [id])
  createdBy  User       @relation("CommCreator", fields: [createdById], references: [id])

  @@index([restaurantId, createdAt])
  @@index([customerId])
  @@index([leadId])
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id           String       @id @default(cuid())
  restaurantId String
  title        String
  description  String?
  dueDate      DateTime?
  status       TaskStatus   @default(PENDING)
  priority     TaskPriority @default(MEDIUM)
  leadId       String?
  customerId   String?
  assignedToId String?
  createdById  String
  completedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  lead       Lead?      @relation(fields: [leadId], references: [id])
  customer   Customer?  @relation(fields: [customerId], references: [id])
  assignedTo User?      @relation("TaskAssignee", fields: [assignedToId], references: [id])
  createdBy  User       @relation("TaskCreator", fields: [createdById], references: [id])

  @@index([restaurantId, status])
  @@index([restaurantId, dueDate])
}

// ============================================================================
// Campaigns / Marketing
// ============================================================================

enum CampaignChannel {
  SMS
  WHATSAPP
  EMAIL
}

enum CampaignSegment {
  ALL
  NEW
  REGULAR
  VIP
  AT_RISK
  INACTIVE
}

enum CampaignStatus {
  DRAFT
  SENT
}

model Campaign {
  id            String          @id @default(cuid())
  restaurantId  String
  name          String
  description   String?
  channel       CampaignChannel
  targetSegment CampaignSegment
  messageBody   String
  status        CampaignStatus  @default(DRAFT)
  targetCount   Int             @default(0)
  sentCount     Int             @default(0)
  createdById   String
  sentAt        DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  restaurant Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdBy  User          @relation("CampaignCreator", fields: [createdById], references: [id])
  logs       CampaignLog[]

  @@index([restaurantId, status])
  @@index([restaurantId, createdAt])
}

model CampaignLog {
  id         String   @id @default(cuid())
  campaignId String
  customerId String
  channel    CampaignChannel
  status     String           // SENT, DELIVERED, FAILED
  sentAt     DateTime         @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([campaignId])
  @@index([customerId])
}

// ============================================================================
// Audit
// ============================================================================

model AuditLog {
  id           String   @id @default(cuid())
  restaurantId String
  actorId      String?
  action       String           // "order.create", "menu.update"
  entityType   String
  entityId     String
  before       Json?
  after        Json?
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  actor      User?      @relation(fields: [actorId], references: [id])

  @@index([restaurantId, createdAt])
  @@index([restaurantId, entityType, entityId])
}
