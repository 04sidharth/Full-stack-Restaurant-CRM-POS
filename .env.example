# PostgreSQL (used by docker-compose and Prisma)
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm_dev_password
POSTGRES_DB=restaurant_crm
POSTGRES_PORT=5433

# API
API_PORT=4000
DATABASE_URL=postgresql://crm:crm_dev_password@localhost:5433/restaurant_crm?schema=public
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# Web
VITE_API_URL=http://localhost:4000/api
